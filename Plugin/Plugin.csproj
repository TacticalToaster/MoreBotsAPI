		<Reference Include="UnityEngine.UI">
		  <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll</HintPath>
		<Private>false</Private></Reference>
	</ItemGroup>

	<Target Condition="'$(DeployToGame)' == 'true'" Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command='if not exist "$(ProjectDir)$(SPTPath)\BepInEx\plugins\MoreBotsAPI\" mkdir "$(ProjectDir)$(SPTPath)\BepInEx\plugins\MoreBotsAPI"' />
		<Exec Command='copy /Y "$(TargetPath)" "$(ProjectDir)$(SPTPath)\BepInEx\plugins\MoreBotsAPI\$(TargetFileName)"' />
	</Target>

</Project>
